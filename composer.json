{
  "name": "tomohirojin/php-devcontainer",
  "description": "A simple PHP learning project in a DevContainer.",
  "license": "MIT",
  "type": "project",
  "require": {
    "php": "^8.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.0",
    "friendsofphp/php-cs-fixer": "^3.64"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse",
    "fix": "php-cs-fixer fix",
    "fix:check": "php-cs-fixer fix --dry-run --diff",
    "check": [
      "@fix:check",
      "@analyse",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
