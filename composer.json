{
  "name": "tomohirojin/devcontainer-php",
  "description": "PHP learning examples with a reproducible development container.",
  "require": {
    "php": "~8.5.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.4",
    "phpstan/phpstan": "^2.3",
    "friendsofphp/php-cs-fixer": "^3.95"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    },
    "classmap": [
      "src/Reference/Basic/OOPConcepts.php"
    ]
  },
  "autoload-dev": {
    "classmap": [
      "tests/"
    ]
  },
  "scripts": {
    "test": "phpunit",
    "phpunit": "@test",
    "analyse": "phpstan analyse --no-progress --memory-limit=512M",
    "lint": "php-cs-fixer fix --dry-run --diff",
    "format": "php-cs-fixer fix",
    "check": [
      "@test",
      "@analyse",
      "@lint"
    ]
  },
  "license": "MIT",
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  }
}
